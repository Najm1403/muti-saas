# Copy this file to .env and fill in your values.  (core/config.py is the source of truth.)

APP_NAME="Storixx"
ENVIRONMENT=development        # production on the server
DEBUG=false

# ── Database (async psycopg driver) ──────────────────────────
DATABASE_URL=postgresql+psycopg://fastfood:password@localhost:5432/fastfood
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# ── Auth / JWT ──────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_EXPIRE_MINUTES=15

# ── CORS ───────────────────────────────────────────────────
# Comma-separated origins, or "*" for local dev only (credentials disabled when "*").
# Production example: https://app.example.com
CORS_ORIGINS=*

# ── Platform bootstrap (used only by scripts/bootstrap_platform.py) ──
PLATFORM_ADMIN_EMAIL=admin@platform.local
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_NAME=Super Admin

# ── SMTP (Brevo relay or any provider) — needed for password-reset OTP emails ──
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-login
SMTP_PASSWORD=your-smtp-api-key
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=FastFood SaaS
